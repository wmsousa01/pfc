# =====================================================================
# Fora da Caixa — variáveis de ambiente
# Copie para .env.local e preencha. Reinicie o `npm run dev` depois.
# =====================================================================

# --- Supabase (parceiros, tracking, destaques IG, login do admin) ---
# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# NUNCA exponha esta chave no client. Só no servidor.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- YouTube (opcional) ---
# O channel_id do canal já está embutido no código. Só defina para trocar.
# YOUTUBE_CHANNEL_ID=UCskyIZf6RflDfhUjYZ865Jw

# --- Site (opcional) ---
# Usado como fallback para gerar URLs absolutas de QR fora de uma request.
# Use o host canônico COM www: o apex responde 308 para ele.
# NEXT_PUBLIC_SITE_URL=https://www.pfctv.com.br

# --- Produção de cortes (/admin/producao) ---
# OAuth do Google com a YouTube Data API v3 ativada. Redirect URI autorizada:
#   https://www.pfctv.com.br/api/producao/oauth/callback (e http://localhost:3000/... no dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gemini (Google AI Studio): headline e imagem da thumb.
GOOGLE_AI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3-pro-image
# GEMINI_TEXT_MODEL=gemini-3.5-flash
# A Vercel manda este segredo no cron /api/cron/producao.
CRON_SECRET=
# Contenta: rota interna /api/internal/hub (mesmo valor de INTERNAL_HUB_SECRET lá).
CONTENTA_HUB_SECRET=
# CONTENTA_HUB_URL=https://www.contentaai.com.br

# --- Marketing (/admin/marketing) ---
# Chave que cifra os tokens das redes no banco: openssl rand -base64 32
SOCIAL_TOKEN_KEY=
# App da Meta (developers.facebook.com, tipo Business) com Facebook Login.
# Redirect URI válida: https://www.pfctv.com.br/api/social/meta/oauth/callback
META_APP_ID=
META_APP_SECRET=
# Só se a conta administrar várias Páginas e o nome não identificar a do PFC.
# META_PAGE_ID=
# META_GRAPH_VERSION=v23.0
